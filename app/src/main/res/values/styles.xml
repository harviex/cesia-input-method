<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 明亮主题 -->
    <style name="Theme.Cesia" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg_primary</item>
    </style>

    <!-- 通用：跟随系统日夜模式（SettingsActivity / NewsSourceActivity 等用，避免被强制浅色） -->
    <style name="Theme.Cesia.DayNight" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary_dark</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg_primary_dark</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>
    <style name="Theme.Cesia.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 黑暗主题 -->
    <style name="Theme.Cesia.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">#1A1A2E</item>
        <!-- colorPrimaryDark 决定系统状态栏底色：原为 #FF03DAC5（青绿），
             导致黑暗模式下顶部时间/电量/信号那条是 Tiffany 蓝。改为与页面同色的深底。 -->
        <item name="colorPrimary">#1A1A2E</item>
        <item name="colorPrimaryDark">#1A1A2E</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">#E0E0E0</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:colorBackground">#1A1A2E</item>
        <!-- 深底配浅色状态栏图标 -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
