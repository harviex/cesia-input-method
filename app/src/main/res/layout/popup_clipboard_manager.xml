<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/sheet_top_rounded">

    <!-- 顶部拖动手柄（长条 handle + 透明命中区，绑定拖动改高度/下滑关闭） -->
    <LinearLayout
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="#D0D0D0"
            android:backgroundTint="#D0D0D0" />

    </LinearLayout>

    <!-- 标题栏：标题 + 右上角 X 关闭 -->
    <LinearLayout
        android:id="@+id/banner_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="剪贴板管理"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/btn_clipboard_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="#666666"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <!-- 搜索栏：统一风格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#FAFAFA">

        <EditText
            android:id="@+id/et_clipboard_search"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="点击后使用中文键盘输入搜索"
            android:textSize="13sp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:background="@drawable/search_bg"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- 搜索编辑状态提示栏 -->
    <TextView
        android:id="@+id/tv_search_edit_hint"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="12sp"
        android:textColor="#666666"
        android:background="#E0F7FA"
        android:visibility="gone" />

    <!-- 两列网格：与魔法书、智能写作一致 -->
    <GridView
        android:id="@+id/gv_clipboard_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:verticalSpacing="4dp"
        android:horizontalSpacing="4dp"
        android:padding="6dp"
        android:stretchMode="columnWidth"
        android:gravity="top"
        android:listSelector="@android:color/transparent" />

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/tv_clipboard_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="没有找到匹配的内容"
        android:textSize="13sp"
        android:textColor="#999999"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <!-- ===== 普通操作栏（方形菜单按钮） ===== -->
    <LinearLayout
        android:id="@+id/action_bar_normal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F5F5F5"
        android:paddingHorizontal="4dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/btn_clipboard_select_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="□"
            android:textSize="18sp"
            android:textColor="#81D8D0"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="批量选择" />

    </LinearLayout>

    <!-- ===== 批量操作栏（默认隐藏） ===== -->
    <LinearLayout
        android:id="@+id/action_bar_batch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="4dp"
        android:elevation="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_clipboard_batch_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="取消"
            android:textSize="15sp"
            android:textColor="#666666"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tv_clipboard_batch_count"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="已选 0"
            android:textSize="13sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/btn_clipboard_batch_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="全选"
            android:textSize="14sp"
            android:textColor="#81D8D0"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_clipboard_batch_pin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="批量置顶"
            android:textSize="14sp"
            android:textColor="#81D8D0"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_clipboard_batch_delete"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="批量删除"
            android:textSize="14sp"
            android:textColor="#E53935"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_clipboard_batch_delete_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="全部删除"
            android:textSize="14sp"
            android:textColor="#E53935"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
