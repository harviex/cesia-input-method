<?xml version="1.0" encoding="utf-8"?>
<!--
    合并符号键盘（单页）— 主字符=CJ符号，副字符=EN变体（长按输出）
    设计（41 符号键 = 第1~4行39 + 第5行2）：
      - 配对键（（）《》〔〕[]『』【】""）：点一下出一对、光标居中（commitText(pair,1)）
      - 第5行：←返回 | ⇄翻转主副 | 〰️符库 | 空格 | — | …… | ↵回车
      - ⇄(-105) 翻转主/副语言并持久化；常打英文者翻后为 主=EN 副=CJ
    已排除全键盘/T9 已有标点（, . ! ? ？ ： ; ； “ # @ $ % ^ & * ( ) + - × ÷ = : / \ _ —）
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="48dp"
    android:horizontalGap="0dp"
    android:verticalGap="4dp">

    <!-- ===== 第1行：引号/括号/书名号（10键，1~7为配对键） ===== -->
    <Row>
        <Key android:codes="-301" android:keyLabel="（）" android:popupCharacters="()" android:keyEdgeFlags="left" />
        <Key android:codes="-302" android:keyLabel="《》" android:popupCharacters="⟨⟩" />
        <Key android:codes="-303" android:keyLabel="〔〕" android:popupCharacters="{}" />
        <Key android:codes="-304" android:keyLabel="[]" android:popupCharacters="&lt;&gt;" />
        <Key android:codes="-305" android:keyLabel="『』" android:popupCharacters="「」" />
        <Key android:codes="-306" android:keyLabel="【】" android:popupCharacters="⟦ ⟧" />
        <Key android:codes="-307" android:keyLabel="“”" android:popupCharacters="‘’" />
        <Key android:codes="-308" android:keyLabel="、" android:popupCharacters="`" />
        <Key android:codes="-309" android:keyLabel=";" android:popupCharacters="；" />
        <Key android:codes="-310" android:keyLabel="," android:popupCharacters="," android:keyEdgeFlags="right" />
    </Row>

    <!-- ===== 第2行：数学/比较/货币（10键） ===== -->
    <Row>
        <Key android:codes="-311" android:keyLabel="+" android:popupCharacters="-" android:keyEdgeFlags="left" />
        <Key android:codes="-312" android:keyLabel="×" android:popupCharacters="÷" />
        <Key android:codes="-313" android:keyLabel="√" android:popupCharacters="✕" />
        <Key android:codes="-314" android:keyLabel="=" android:popupCharacters="≈" />
        <Key android:codes="-315" android:keyLabel="&lt;" android:popupCharacters="≤" />
        <Key android:codes="-316" android:keyLabel="&gt;" android:popupCharacters="≥" />
        <Key android:codes="-317" android:keyLabel="%" android:popupCharacters="‰" />
        <Key android:codes="-318" android:keyLabel="～" android:popupCharacters="~" />
        <Key android:codes="-319" android:keyLabel="·" android:popupCharacters="∙" />
        <Key android:codes="-320" android:keyLabel="。" android:popupCharacters="." android:keyEdgeFlags="right" />
    </Row>

    <!-- ===== 第3行：符号/形状/校验（10键） ===== -->
    <Row>
        <Key android:codes="-321" android:keyLabel="*" android:popupCharacters="#" android:keyEdgeFlags="left" />
        <Key android:codes="-322" android:keyLabel="@" android:popupCharacters="&amp;" />
        <Key android:codes="-323" android:keyLabel="/" android:popupCharacters="\" />
        <Key android:codes="-324" android:keyLabel="|" android:popupCharacters="¦" />
        <Key android:codes="-325" android:keyLabel="°" android:popupCharacters="′" />
        <Key android:codes="-326" android:keyLabel="∞" android:popupCharacters="∾" />
        <Key android:codes="-327" android:keyLabel="■" android:popupCharacters="□" />
        <Key android:codes="-328" android:keyLabel="★" android:popupCharacters="☆" />
        <Key android:codes="-329" android:keyLabel="！" android:popupCharacters="!" />
        <Key android:codes="-330" android:keyLabel="?" android:popupCharacters="？" android:keyEdgeFlags="right" />
    </Row>

    <!-- ===== 第4行：序号/单位/希腊/货币（9键 + 退格） ===== -->
    <Row>
        <Key android:codes="-331" android:keyLabel="①" android:popupCharacters="②" android:keyEdgeFlags="left" />
        <Key android:codes="-332" android:keyLabel="③" android:popupCharacters="④" />
        <Key android:codes="-333" android:keyLabel="⑤" android:popupCharacters="⑥" />
        <Key android:codes="-334" android:keyLabel="⑦" android:popupCharacters="⑧" />
        <Key android:codes="-335" android:keyLabel="⑨" android:popupCharacters="⑩" />
        <Key android:codes="-336" android:keyLabel="α" android:popupCharacters="β" />
        <Key android:codes="-337" android:keyLabel="℃" android:popupCharacters="℉" />
        <Key android:codes="-338" android:keyLabel="€" android:popupCharacters="₿" />
        <Key android:codes="-339" android:keyLabel="¥" android:popupCharacters="$" />
        <Key android:codes="-5" android:keyLabel="⌫" android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <!-- ===== 第5行：返回 + 翻转 + 符库 + 空格 + — + …… + 回车（7键，总宽100%） ===== -->
    <Row>
        <Key android:codes="-999" android:keyLabel="←" android:keyEdgeFlags="left" android:keyWidth="11%p" />
        <Key android:codes="-105" android:keyLabel="⇄" android:keyWidth="10%p" />
        <Key android:codes="-103" android:keyLabel="〰️" android:keyWidth="10%p" />
        <Key android:codes="32" android:keyLabel="       " android:keyWidth="33%p" />
        <Key android:codes="-340" android:keyLabel="—" android:popupCharacters="——" android:keyWidth="10%p" />
        <Key android:codes="-341" android:keyLabel="……" android:popupCharacters="…" android:keyWidth="10%p" />
        <Key android:codes="10" android:keyLabel="↵" android:keyEdgeFlags="right" android:keyWidth="16%p" />
    </Row>

</Keyboard>
